program ValidoSintatico

declarations
varType integer: idade, contador;
varType real: salario;
varType string: nome;
varType boolean: ativo;
endDeclararions

functions
funcType void: processar(paramType integer: valor)
{
    idade := valor;
    salario := 100.5 + idade * 2;
    ativo := true;
    if (idade >= 18)
        print nome
    else
        print "MENOR"
    endIf;
    while (contador < 10)
    {
        contador := contador + 1;
        if (contador == 5)
            break
        endIf
    }
    endWhile;
    return idade
}
endFunction
endFunctions

endProgram
