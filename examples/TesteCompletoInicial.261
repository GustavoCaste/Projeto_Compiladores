program Completo2026

declarations
varType integer: idade, contador;
varType real: salario;
varType string: nome;
varType character: inicial;
varType boolean: ativo;
endDeclararions

functions
funcType void: processar(?)
{
    paramType integer: valor;
    idade := 25;
    salario := 1500.75e+2;
    nome := "JOAO SILVA";
    inicial := 'J';
    ativo := true;

    // comentario de linha

    if (idade >= 18)
        print nome
    else
        print "MENOR"
    endIf;

    /*
       comentario de bloco
       ainda deve ser ignorado futuramente
    */

    while (contador < 10)
        contador := contador + 1
        if (contador == 5)
            break
        endIf
    endWhile;

    return
}
endFunction
endFunctions

endProgram
